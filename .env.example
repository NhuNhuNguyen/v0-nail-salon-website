# Supabase
# Supabase — replace with your project credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_KEY=

# Gmail Configuration (for email notifications)
GMAIL_USER=
GMAIL_APP_PASSWORD=
STAFF_EMAIL=

# App URL (used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio Configuration (for SMS notifications - optional but recommended)
# Sign up at https://www.twilio.com/ to get these credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# Cron Secret (for scheduled tasks like reminder emails)
# Generate a random secure string for this
CRON_SECRET=your-random-secure-string-here

# Future: Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
